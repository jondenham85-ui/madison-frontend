"use client";

import { useState } from "react";

type ControlMetric = {
  label: string;
  value: string;
  status: "stable" | "warning" | "critical";
};

const initialMetrics: ControlMetric[] = [
  {
    label: "Store Pipeline",
    value: "Stable",
    status: "stable",
  },
  {
    label: "Task Queue",
    value: "12 open",
    status: "warning",
  },
  {
    label: "Revenue Stream",
    value: "$3.2K / 24h (simulated)",
    status: "stable",
  },
  {
    label: "Automation Routines",
    value: "5 active",
    status: "stable",
  },
];

export default function ControlRoomPanel() {
  const [metrics] = useState<ControlMetric[]>(initialMetrics);
  const [selected, setSelected] = useState<string>("Store Pipeline");

  return (
    <section className="px-6 pb-20">
      <div className="max-w-6xl mx-auto">
        <div className="flex items-center justify-between mb-6">
          <h2 className="text-2xl md:text-3xl font-bold text-teal-200">
            Madison Control Room
          </h2>
          <span className="text-xs px-3 py-1 rounded-full bg-teal-400/20 text-teal-200 border border-teal-400/60">
            OWNER ACCESS: JON + ALISON
          </span>
        </div>

        <p className="text-gray-300 mb-8 max-w-2xl">
          This panel represents how Madison watches your system: store, tasks,
          revenue, and automation flows. When you connect real backends, these
          tiles become live telemetry.
        </p>

        <div className="grid md:grid-cols-[1.4fr,1fr] gap-8">
          {/* Left: Metrics grid */}
          <div
            className="
              p-6 rounded-2xl
              bg-[#050505]/90 backdrop-blur-xl
              border border-teal-400/40
              shadow-[0_0_30px_#00E5FF55]
            "
          >
            <h3 className="text-lg font-semibold text-teal-200 mb-4">
              System Overview
            </h3>

            <div className="grid sm:grid-cols-2 gap-4">
              {metrics.map((metric) => {
                const isSelected = metric.label === selected;

                const statusColor =
                  metric.status === "stable"
                    ? "text-teal-300"
                    : metric.status === "warning"
                    ? "text-yellow-300"
                    : "text-red-400";

                const statusLabel =
                  metric.status === "stable"
                    ? "Stable"
                    : metric.status === "warning"
                    ? "Attention"
                    : "Critical";

                return (
                  <button
                    key={metric.label}
                    onClick={() => setSelected(metric.label)}
                    className={`
                      text-left p-4 rounded-xl
                      bg-black/70 border
                      ${
                        isSelected
                          ? "border-teal-300 shadow-[0_0_25px_#00E5FF66]"
                          : "border-teal-400/40"
                      }
                      hover:border-teal-300/80 hover:shadow-[0_0_25px_#00E5FF55]
                      transition
                    `}
                  >
                    <div className="flex items-center justify-between mb-1">
                      <span className="text-sm font-semibold text-teal-200">
                        {metric.label}
                      </span>
                      <span
                        className={`
                          text-[0.7rem] px-2 py-1 rounded-full border
                          ${statusColor}
                          ${
                            metric.status === "stable"
                              ? "border-teal-300/60"
                              : metric.status === "warning"
                              ? "border-yellow-300/60"
                              : "border-red-400/60"
                          }
                        `}
                      >
                        {statusLabel}
                      </span>
                    </div>
                    <p className="text-xs text-gray-300">{metric.value}</p>
                  </button>
                );
              })}
            </div>
          </div>

          {/* Right: Detail panel */}
          <div
            className="
              p-6 rounded-2xl
              bg-[#050505]/90 backdrop-blur-xl
              border border-teal-400/40
              shadow-[0_0_30px_#00E5FF55]
            "
          >
            <h3 className="text-lg font-semibold text-teal-200 mb-4">
              Madison Insight
            </h3>

            <p className="text-sm text-gray-300 mb-4">
              Selected channel:{" "}
              <span className="text-teal-200 font-semibold">{selected}</span>
            </p>

            <div className="text-sm text-gray-300 space-y-3">
              {selected === "Store Pipeline" && (
                <>
                  <p>
                    Madison treats the store pipeline as a live stream: orders,
                    products, inventory, and customer events. Once wired to
                    Shopify or your store backend, this tile becomes a real
                    status monitor.
                  </p>
                  <p>
                    You can extend this panel to show: error rates, abandoned
                    carts, and automation triggers for recovery flows.
                  </p>
                </>
              )}

              {selected === "Task Queue" && (
                <>
                  <p>
                    The task queue represents everything Madison is tracking:
                    owner tasks, automation tasks, and system jobs. When
                    connected to a task backend, this becomes a live Kanban
                    feed.
                  </p>
                  <p>
                    You can route commands from the chat console directly into
                    this queue and mark them complete from here.
                  </p>
                </>
              )}

              {selected === "Revenue Stream" && (
                <>
                  <p>
                    Revenue stream is where Madison watches money: daily,
                    weekly, and monthly performance. With a real integration,
                    this tile would show live charts and anomaly detection.
                  </p>
                  <p>
                    You can later add alerts here for sudden drops, spikes, or
                    broken funnels.
                  </p>
                </>
              )}

              {selected === "Automation Routines" && (
                <>
                  <p>
                    Automation routines are the sequences Madison runs: nightly
                    jobs, sync tasks, cleanup flows, and marketing triggers.
                  </p>
                  <p>
                    Once connected, this tile can show which routines are
                    active, failing, or paused — and let you toggle them with a
                    single click.
                  </p>
                </>
              )}
            </div>

            <div className="mt-6 text-xs text-teal-300">
              This panel is currently simulated. When you’re ready, we can
              replace these placeholders with live data from your real
              backends.
            </div>
          </div>
        </div>
      </div>
    </section>
  );
}
